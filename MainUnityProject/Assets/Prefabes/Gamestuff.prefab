  m_Name: 
  m_EditorClassIdentifier: '::'
  tutorialTextUI: {fileID: 5657013064063283482}
  tutorialTexts:
  - Welcome traveler. I will guide you through the very basics. Start by holding
    RMB.
  - Draw the symbol found on the wall, by holding LMB.
  - Good. Now draw it 2 more times without letting go of RMB.
  - Now release RMB, and press SPACE to cast at the door. It seems to be stuck.
  - Remember to look for more murals. That will be all. Good luck, traveler...
  currentStep: -1
  stepAction:
    m_Name: Step
    m_Type: 0
